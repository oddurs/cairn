---
import Base from "../layouts/Base.astro";
import Band from "../components/Band.astro";
import Grid from "../components/Grid.astro";
import Stack from "../components/Stack.astro";
import Button from "../components/Button.astro";
import Lede from "../components/Lede.astro";
import Terminal from "../components/Terminal.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const guarantees = [
  {
    title: "Writes cannot be half-finished",
    body: "Every file is written beside its target, flushed, and renamed over it. A crash leaves the old contents or the new ones, never a mixture. There is a test that kills the program mid-write forty times.",
  },
  {
    title: "Branches merge without a fight",
    body: "Two branches that both add an item would conflict in the generated roadmap and collide on an identifier. Neither is a real conflict, so cairn teaches git to re-derive both instead.",
  },
  {
    title: "The format is specified",
    body: "The item format is written down independently of this program, versioned, and pinned by a corpus of files that must keep parsing the same way.",
  },
  {
    title: "Concurrent writers are safe",
    body: "Mutating commands take a lock; reads never do. Forty processes creating items at once produce forty distinct identifiers, and twelve agents racing for one item produce exactly one owner.",
  },
];
---

<Base
  title="cairn — a roadmap that lives in your repository"
  description="cairn keeps a project's roadmap and issues as Markdown files in the repository, under a schema you define, with tools that let coding agents work the backlog."
>
  {/* The artefact is the argument: an item is a file, so lead with the file,
      read off disk rather than typed to look right. */}
  <Band first>
    <Grid cols={2} gap="8" min="26rem">
      <Stack gap="5">
        <h1>Your backlog is a directory of Markdown files.</h1>
        <Lede narrow>
          cairn keeps a project's roadmap and issues in the repository itself,
          under a schema you declare. Reviewable in the pull request that closes
          them. Readable in ten years. No server, no account, no browser.
        </Lede>
        <div class="install">
          <pre><code>curl -fsSL https://raw.githubusercontent.com/oddurs/cairn/main/install.sh | sh</code></pre>
        </div>
        <p class="aside">
          Or <code>brew tap oddurs/cairn &amp;&amp; brew install cairn</code>.
          Linux, macOS and Windows.
        </p>
        <p class="row">
          <Button href={`${base}/docs`}>Read the docs</Button>
          <Button href="https://github.com/oddurs/cairn" variant="quiet">
            Source on GitHub
          </Button>
        </p>
      </Stack>
      <Terminal name="item" />
    </Grid>
  </Band>

  <Band tone="sunken">
    <Stack gap="6">
      <Stack gap="3">
        <h2>See the whole thing at a glance</h2>
        <Lede>
          Columns come from the statuses you declared, in the order you declared
          them. Width follows content, so an empty column does not take a full
          share. A leading <code>!</code> marks work that cannot be started
          because something else is unfinished.
        </Lede>
      </Stack>
      <Terminal name="board" />
    </Stack>
  </Band>

  <Band>
    <Stack gap="6">
      <h2>The loop is two commands</h2>
      <Grid cols={2} gap="7" min="26rem">
        <Terminal
          name="next"
          caption="Work that is genuinely startable. Anything waiting on unfinished work is excluded, and what is already under way comes first — the most useful next action is usually finishing something."
        />
        <Terminal
          name="claim"
          caption="Takes the top-ranked unclaimed item, writes your name into it, and prints its body so work can begin. It refuses an item somebody else holds, and one that is blocked."
        />
      </Grid>
    </Stack>
  </Band>

  <Band tone="sunken">
    <Stack gap="6">
      <Stack gap="3">
        <h2>Recorded, not illustrated</h2>
        <Lede>
          Every terminal on this page — the file, the board, the listings, the
          rejected tool call — was captured by running the real thing. So was
          the session below. All of it is regenerated on each change, and
          continuous integration fails if any of it stops matching what the
          program does.
        </Lede>
      </Stack>
      <img
        class="demo"
        src={`${base}/demo.svg`}
        alt="A terminal session: creating two items where the second depends on the first, running cairn next, claiming the top item, closing it, and watching the dependent item become available."
        loading="lazy"
        decoding="async"
      />
    </Stack>
  </Band>

  <Band>
    <Grid cols={2} gap="8" min="26rem">
      <Stack gap="3">
        <h2>Agents get tools, not instructions</h2>
        <Lede>
          <code>cairn mcp</code> serves the backlog over the Model Context
          Protocol. A rejected write comes back as something the model can act
          on, so it corrects itself instead of inventing a format.
        </Lede>
        <p class="row">
          <Button href={`${base}/docs/agents`} variant="quiet">
            How to set it up
          </Button>
        </p>
      </Stack>
      <Terminal name="mcp" />
    </Grid>
  </Band>

  <Band tone="sunken">
    <Stack gap="6">
      <h2>Built to be left alone</h2>
      <Grid cols={2} gap="7" min="24rem">
        {
          guarantees.map((g) => (
            <Stack gap="2">
              <h3>{g.title}</h3>
              <p class="muted">{g.body}</p>
            </Stack>
          ))
        }
      </Grid>
    </Stack>
  </Band>

  <Band>
    <Grid cols={2} gap="8" min="26rem" align="center">
      <Stack gap="4">
        <h2>Milestones, from the same files</h2>
        <Lede>
          The roadmap is derived from the items, so it cannot describe a plan
          nobody is working on.
        </Lede>
        <p class="row">
          <Button href={`${base}/docs`}>Read the docs</Button>
          <Button href={`${base}/format`} variant="quiet">The item format</Button>
        </p>
      </Stack>
      <Terminal name="roadmap" />
    </Grid>
  </Band>

  <style>
    /* The only page-level rules that remain: three arrangements the system has
       no general name for. Everything else is a token or a component. */
    .install pre {
      border-left: 2px solid var(--accent);
    }
    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-5);
      margin: 0;
    }
    .aside,
    .muted {
      color: var(--fg-muted);
      font-size: var(--text-sm);
      margin: 0;
    }
    .aside code {
      color: var(--fg);
    }
    .demo {
      display: block;
      width: 100%;
      border: var(--hairline);
      border-radius: var(--radius-lg);
    }
  </style>
</Base>
