---
import Base from "../layouts/Base.astro";
import Terminal from "../components/Terminal.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Base
  title="cairn — a roadmap that lives in your repository"
  description="cairn keeps a project's roadmap and issues as Markdown files in the repository, under a schema you define, with tools that let coding agents work the backlog."
  wide
>
  <!-- The artefact is the argument: an item is a file, so lead with the file,
       read straight off disk rather than typed to look right. -->
  <section class="hero">
    <div class="wrap hero__inner">
      <div class="hero__claim">
        <h1>Your backlog is a directory of Markdown files.</h1>
        <p class="lede">
          cairn keeps a project's roadmap and issues in the repository itself,
          under a schema you declare. Reviewable in the pull request that closes
          them. Readable in ten years. No server, no account, no browser.
        </p>

        <div class="install">
          <pre><code>curl -fsSL https://raw.githubusercontent.com/oddurs/cairn/main/install.sh | sh</code></pre>
          <p class="install__alt">
            Or <code>brew tap oddurs/cairn &amp;&amp; brew install cairn</code>.
            Linux, macOS and Windows.
          </p>
        </div>

        <p class="actions">
          <a class="cta" href={`${base}/docs`}>Read the docs</a>
          <a href="https://github.com/oddurs/cairn">Source on GitHub</a>
        </p>
      </div>

      <div class="hero__file">
        <Terminal name="item" />
      </div>
    </div>
  </section>

  <!-- The board is the most distinctive thing the program prints, so it gets a
       band of its own rather than a corner of a grid. -->
  <section class="band band--deep">
    <div class="wrap">
      <div class="split">
        <div>
          <h2>See the whole thing at a glance</h2>
          <p class="lede">
            Columns come from the statuses you declared, in the order you
            declared them. Width follows content, so an empty column does not
            take a full share. A leading <code>!</code> marks work that cannot
            be started because something else is unfinished.
          </p>
        </div>
      </div>
      <div class="board">
        <Terminal name="board" />
      </div>
    </div>
  </section>

  <!-- Two commands carry the day, so they get equal weight side by side. -->
  <section class="band">
    <div class="wrap">
      <h2>The loop is two commands</h2>
      <div class="duo">
        <Terminal
          name="next"
          caption="Work that is genuinely startable. Anything waiting on unfinished work is excluded, and what is already under way comes first — the most useful next action is usually finishing something."
        />
        <Terminal
          name="claim"
          caption="Takes the top-ranked unclaimed item, writes your name into it, and prints its body so work can begin. It refuses an item somebody else holds, and one that is blocked."
        />
      </div>
    </div>
  </section>

  <section class="band band--deep">
    <div class="wrap">
      <h2>Recorded, not illustrated</h2>
      <p class="lede">
        Every terminal on this page — the file, the board, the listings, the
        rejected tool call — was captured by running the real thing. So was the
        session below. All of it is regenerated on each change, and continuous
        integration fails if any of it stops matching what the program does.
      </p>
      <img
        class="demo"
        src={`${base}/demo.svg`}
        alt="A terminal session: creating two items where the second depends on the first, running cairn next, claiming the top item, closing it, and watching the dependent item become available."
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <!-- Strata rather than three identical cards. -->
  <section class="band">
    <div class="wrap strata">
      <article class="stratum">
        <div class="stratum__lede">
          <h3>The schema is yours</h3>
          <p>
            Item types, statuses, custom fields, milestones and saved views are
            declared in one file. Rename <code>doing</code> to whatever your
            team says — every status belongs to a fixed category, so progress
            bars and <code>cairn close</code> keep working regardless.
          </p>
        </div>
        <pre class="stratum__code slab"><code><span class="d">[[status]]</span>
<span class="b">name</span>     = "doing"
<span class="b">label</span>    = "in progress"
<span class="b">category</span> = "active"
<span class="b">color</span>    = "yellow"</code></pre>
      </article>

      <article class="stratum">
        <div class="stratum__lede">
          <h3>Agents get tools, not instructions</h3>
          <p>
            <code>cairn mcp</code> serves the backlog over the Model Context
            Protocol. A rejected write comes back as something the model can act
            on, so it corrects itself instead of inventing a format.
          </p>
        </div>
        <div class="stratum__code">
          <Terminal name="mcp" />
        </div>
      </article>

      <article class="stratum">
        <div class="stratum__lede">
          <h3>Nothing drifts</h3>
          <p>
            <code>ROADMAP.md</code> is generated and re-rendered whenever an item
            changes. One line in continuous integration validates every item and
            proves the committed roadmap still matches them.
          </p>
        </div>
        <div class="stratum__code">
          <Terminal name="check" />
        </div>
      </article>
    </div>
  </section>

  <section class="band band--deep">
    <div class="wrap">
      <h2>Built to be left alone</h2>
      <div class="pairs">
        <div>
          <h3>Writes cannot be half-finished</h3>
          <p>
            Every file is written beside its target, flushed, and renamed over
            it. A crash leaves the old contents or the new ones, never a
            mixture. There is a test that kills the program mid-write forty
            times.
          </p>
        </div>
        <div>
          <h3>Branches merge without a fight</h3>
          <p>
            Two branches that both add an item would conflict in the generated
            roadmap and collide on an identifier. Neither is a real conflict, so
            <code>cairn init --git</code> teaches git to re-derive both instead.
          </p>
        </div>
        <div>
          <h3>The format is specified</h3>
          <p>
            The item format is <a href={`${base}/format`}>written down</a>
            independently of this program, versioned, and pinned by a corpus of
            files that must keep parsing the same way.
          </p>
        </div>
        <div>
          <h3>Concurrent writers are safe</h3>
          <p>
            Mutating commands take a lock; reads never do. Forty processes
            creating items at once produce forty distinct identifiers, and
            twelve agents racing for one item produce exactly one owner.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band close">
    <div class="wrap close__inner">
      <div>
        <h2>Milestones, from the same files</h2>
        <p class="lede">
          The roadmap is derived from the items, so it cannot describe a plan
          nobody is working on.
        </p>
        <p class="actions">
          <a class="cta" href={`${base}/docs`}>Read the docs</a>
          <a href={`${base}/docs/agents`}>Set it up for an agent</a>
        </p>
      </div>
      <Terminal name="roadmap" />
    </div>
  </section>

  <style>
    .hero {
      padding-block: clamp(2.5rem, 7vw, 5rem);
    }
    .hero__inner {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      grid-template-columns: 1fr;
      align-items: start;
    }
    @media (min-width: 64rem) {
      .hero__inner {
        grid-template-columns: 1fr 1fr;
      }
    }
    .hero__claim h1 {
      margin-bottom: 1.1rem;
    }
    .hero__claim .lede {
      max-width: 46ch;
    }

    .install {
      margin-block: 1.75rem 1.25rem;
    }
    .install pre {
      background: var(--slate-deep);
      border: 1px solid var(--hairline);
      border-left: 2px solid var(--lichen);
      border-radius: 3px;
      font-size: 0.8125rem;
    }
    .install__alt {
      margin: 0.7rem 0 0;
      color: var(--moss);
      font-size: 0.9375rem;
    }
    .install__alt code {
      color: var(--chalk);
      font-size: 0.85em;
    }

    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1.5rem;
      margin-top: 1.75rem;
    }
    .cta {
      background: var(--lichen);
      color: var(--slate);
      font-family: var(--mono);
      font-weight: 600;
      font-size: 0.9375rem;
      padding: 0.6rem 1.1rem;
      border-radius: 2px;
      text-decoration: none;
    }
    .cta:hover {
      background: #c8d84f;
    }

    .split h2 {
      margin-bottom: 0.9rem;
    }
    .split .lede {
      max-width: 62ch;
    }
    .board {
      margin-top: 1.75rem;
    }

    .duo {
      display: grid;
      gap: 2.25rem;
      margin-top: 1.75rem;
    }
    @media (min-width: 64rem) {
      .duo {
        grid-template-columns: 1fr 1fr;
        align-items: start;
      }
    }

    .demo {
      width: 100%;
      height: auto;
      display: block;
      margin-top: 2rem;
      border: 1px solid var(--hairline);
      border-radius: 4px;
    }

    .strata {
      display: grid;
    }
    .stratum {
      display: grid;
      gap: 1.5rem 3.5rem;
      padding-block: 2.5rem;
      border-bottom: 1px solid var(--hairline);
      align-items: start;
    }
    .stratum:first-child {
      padding-top: 0;
    }
    .stratum:last-child {
      border-bottom: 0;
      padding-bottom: 0;
    }
    @media (min-width: 58rem) {
      .stratum {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      }
    }
    .stratum h3 {
      margin: 0 0 0.5rem;
    }
    .stratum__lede p {
      margin: 0;
      color: var(--moss);
    }
    .stratum__code {
      font-size: 0.8125rem;
    }

    .pairs {
      display: grid;
      gap: 2rem 3.5rem;
      margin-top: 2rem;
    }
    @media (min-width: 46rem) {
      .pairs {
        grid-template-columns: 1fr 1fr;
      }
    }
    .pairs h3 {
      margin: 0 0 0.4rem;
    }
    .pairs p {
      margin: 0;
      color: var(--moss);
    }

    .close__inner {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      align-items: center;
    }
    @media (min-width: 64rem) {
      .close__inner {
        grid-template-columns: 0.85fr 1.15fr;
      }
    }
  </style>
</Base>
