---
import Base from "./Base.astro";
const { title, description, summary } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const sections = [
  {
    label: "Using cairn",
    pages: [
      { href: `${base}/docs`, label: "Getting started" },
      { href: `${base}/docs/configuration`, label: "The schema" },
      { href: `${base}/docs/agents`, label: "Agents" },
      { href: `${base}/docs/durability`, label: "Durability" },
    ],
  },
  {
    label: "Reference",
    pages: [
      { href: `${base}/format`, label: "Item format" },
      {
        href: "https://github.com/oddurs/cairn/blob/main/doc/cairn.texi",
        label: "The manual",
      },
    ],
  },
];
const here = Astro.url.pathname.replace(/\/$/, "");
---

<Base title={title} description={description} wide>
  <div class="wrap docs">
    <nav class="docs__nav" aria-label="Documentation">
      {
        sections.map((s) => (
          <div class="docs__group">
            <p class="docs__grouplabel">{s.label}</p>
            <ul>
              {s.pages.map((p) => (
                <li>
                  <a
                    href={p.href}
                    aria-current={here === p.href ? "page" : undefined}
                  >
                    {p.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>

    <article class="docs__body">
      <h1>{title}</h1>
      {summary && <p class="lede">{summary}</p>}
      <slot />
    </article>
  </div>

  <style>
    .docs {
      display: grid;
      gap: clamp(2rem, 5vw, 4rem);
      padding-block: clamp(2.5rem, 5vw, 4rem);
      align-items: start;
    }
    @media (min-width: 56rem) {
      .docs {
        grid-template-columns: 14rem minmax(0, 1fr);
      }
      .docs__nav {
        position: sticky;
        top: 5rem;
      }
    }
    .docs__group + .docs__group {
      margin-top: 1.75rem;
    }
    .docs__grouplabel {
      margin: 0 0 0.5rem;
      font-size: 0.875rem;
      color: var(--moss);
    }
    .docs__nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      border-left: 1px solid var(--hairline);
    }
    .docs__nav li a {
      display: block;
      padding: 0.32rem 0 0.32rem 0.9rem;
      margin-left: -1px;
      border-left: 1px solid transparent;
      text-decoration: none;
      color: var(--moss);
      font-size: 0.9375rem;
    }
    .docs__nav li a:hover {
      color: var(--chalk);
    }
    .docs__nav li a[aria-current="page"] {
      color: var(--chalk);
      border-left-color: var(--lichen);
    }

    .docs__body :global(h1) {
      margin-bottom: 0.75rem;
    }
    .docs__body :global(h2) {
      margin-top: 2.75rem;
      margin-bottom: 0.75rem;
      padding-top: 1.75rem;
      border-top: 1px solid var(--hairline);
    }
    .docs__body :global(h3) {
      margin-top: 1.75rem;
      margin-bottom: 0.4rem;
    }
    .docs__body :global(p),
    .docs__body :global(ul),
    .docs__body :global(ol) {
      margin-block: 0 1rem;
    }
    .docs__body :global(ul),
    .docs__body :global(ol) {
      padding-left: 1.15rem;
    }
    .docs__body :global(li) {
      margin-bottom: 0.35rem;
    }
    .docs__body :global(pre) {
      background: var(--slate-deep);
      border: 1px solid var(--hairline);
      border-radius: 3px;
      margin-block: 0 1.25rem;
    }
    .docs__body :global(:not(pre) > code) {
      background: var(--slate-lift);
      padding: 0.1em 0.35em;
      border-radius: 2px;
      font-size: 0.86em;
    }
    .docs__body :global(table) {
      border-collapse: collapse;
      width: 100%;
      margin-bottom: 1.25rem;
      font-size: 0.9375rem;
    }
    .docs__body :global(th),
    .docs__body :global(td) {
      text-align: left;
      padding: 0.5rem 0.9rem 0.5rem 0;
      border-bottom: 1px solid var(--hairline);
      vertical-align: top;
    }
    .docs__body :global(th) {
      color: var(--moss);
      font-weight: 500;
    }
    .docs__body :global(blockquote) {
      margin: 0 0 1.25rem;
      padding-left: 1rem;
      border-left: 2px solid var(--lichen);
      color: var(--chalk);
    }
    .docs__body :global(hr) {
      border: 0;
      border-top: 1px solid var(--hairline);
      margin-block: 2rem;
    }
  </style>
</Base>
