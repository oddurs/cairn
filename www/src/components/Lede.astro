---
/* The sentence under a heading. Muted, and held to a shorter measure than body
   prose so it reads as an opening rather than a paragraph. */
const { narrow = false } = Astro.props;
---

<p class:list={["lede", narrow && "lede--narrow"]}><slot /></p>

<style>
  .lede {
    color: var(--fg-muted);
    font-size: var(--text-lg);
    margin: 0;
  }
  .lede--narrow {
    max-width: var(--measure-tight);
  }
</style>
