---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { href: `${base}/docs`, label: "Docs" },
  { href: `${base}/format`, label: "Format" },
  { href: `${base}/design`, label: "Design" },
  { href: "https://github.com/oddurs/cairn", label: "GitHub" },
];
const here = Astro.url.pathname.replace(/\/$/, "");
---

<header class="head">
  <div class="head__wrap">
    <a class="mark" href={base || "/"}>
      <span class="mark__stack" aria-hidden="true"><i></i><i></i><i></i></span>
      cairn
    </a>
    <nav aria-label="Primary">
      {
        links.map((l) => (
          <a href={l.href} aria-current={here === l.href ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .head {
    border-bottom: var(--hairline);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 5;
  }
  .head__wrap {
    max-width: var(--page-max);
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--sticky-top);
  }
  .mark {
    font-family: var(--font-mono);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  /* Three stones narrowing upward — the thing the project is named after, and
     the only ornament on the site. */
  .mark__stack {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5px;
  }
  .mark__stack i {
    display: block;
    height: 3px;
    background: var(--accent);
    border-radius: 1px;
  }
  .mark__stack i:nth-child(1) { width: 5px; }
  .mark__stack i:nth-child(2) { width: 9px; }
  .mark__stack i:nth-child(3) { width: 13px; }

  nav {
    display: flex;
    gap: clamp(var(--space-3), 3vw, var(--space-6));
    font-size: var(--text-sm);
  }
  nav a {
    text-decoration: none;
    color: var(--fg-muted);
  }
  nav a:hover,
  nav a[aria-current="page"] {
    color: var(--fg);
  }
</style>
